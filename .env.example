# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (it's in .gitignore)

# ============================================================
# Database Configuration
# ============================================================
DB_URL=jdbc:mysql://localhost:3306/egerton_ams?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ============================================================
# Email Configuration (Jakarta Mail)
# ============================================================
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=admissions@egerton.ac.ke
MAIL_FROM_NAME=Egerton University Admissions

# ============================================================
# Application Settings
# ============================================================
APP_BASE_URL=http://localhost:8080/ams
APP_ENV=development
SESSION_TIMEOUT=30

# ============================================================
# File Upload Settings
# ============================================================
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png
UPLOAD_DIR=/uploads

# ============================================================
# Server Configuration
# ============================================================
SERVER_PORT=8081
SERVER_CONTEXT_PATH=/ams
